# ==============================================================================
# Non-UMI Sequencing Alignment Snakemake Pipeline
# Author: Shashwat Sahay (shashwat.sahay@charite.de)
#
# This pipeline coordinates the sequence alignment, duplicate marking, BQSR
# recalibration, and QC metric reporting for paired-end WGS/WES/Panel-seq data.
# ==============================================================================

import os
from datetime import datetime
import pandas as pd
from pathlib import Path
from itertools import product
import tempfile

# Define the container to use for rules using singularity/docker
container: "docker://condaforge/mambaforge"

# Include external Snakemake rule definitions
include: "rules/common.smk"            # Common helpers, config validation, and metadata loading
include: "rules/sort_index.smk"        # BAM sorting and indexing rules
include: "rules/adapter_trimming.smk"  # Read QC with cutadapt (trimming) and fastqc
include: "rules/alignment.smk"         # BWA alignment mapping and lane-merging rules
include: "rules/duplicate_marking.smk" # Duplicate read marking via sambamba
include: "rules/flagstatt.smk"         # Alignment alignment-rate stats using samtools flagstat
include: "rules/metric_hsmetrics.smk"  # Hybrid selection metrics (WES/Panel only)
include: "rules/metric_insert_size.smk" # Insert size distribution metric reporting
include: "rules/metric_mosdepth.smk"    # Fast depth & coverage stats reporting
include: "rules/metric_wgs_coverage.smk" # WGS coverage plot generation (WGS only)
include: "rules/recalibration.smk"     # Base Quality Score Recalibration (BQSR) via GATK



